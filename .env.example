# --- Required ---
# Get one at https://platform.claude.com (API keys)
ANTHROPIC_API_KEY=
# Any phrase you like. Every device asks for it once.
ACCESS_CODE=

# --- Identity ---
ASSISTANT_NAME=Orion
USER_NAME=
# How it addresses you: sir, boss, or leave empty to use your name
HONORIFIC=sir

# --- Brain ---
MODEL=claude-opus-5-5
# low = fastest replies (best for voice). medium/high = deeper thinking, slower.
EFFORT=low

# --- Optional: cinematic voice via ElevenLabs ---
# Without this, your phone/laptop's built-in voice is used.
ELEVENLABS_API_KEY=
# Default is "Daniel" (deep, British). Browse voices in the ElevenLabs Voice Library and paste an ID.
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
